      "id": "79d5f33a-1491-4877-9d9f-be4c2cfde807",
      "name": "Mostrar resultado",
      "webhookId": "57dc9f83-2985-4673-b657-316e5611cfba"
    },
    {
      "parameters": {
        "jsCode": "const respuesta = $input.first().json;\nconst batalla = $('Calcular batalla').first().json;\n\nconst narracion = respuesta.choices?.[0]?.message?.content\n  || 'No se pudo generar la narración de la batalla.';\n\nconst titulo = batalla.ganador === 'empate'\n  ? 'EMPATE'\n  : 'GANADOR: ' + batalla.ganador.toUpperCase();\n\nconst mensajeFinal =\n  batalla.pokemon1 + ': poder ' + batalla.poder1 + '\\n' +\n  batalla.pokemon2 + ': poder ' + batalla.poder2 + '\\n\\n' +\n  narracion;\n\nreturn [{\n  json: {\n    ...batalla,\n    narracion,\n    titulo,\n    mensajeFinal\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2224,
        -128
      ],
      "id": "30908065-62b1-4d23-b0a2-49c4b6407b19",
      "name": "Extraer narracion"
    },
    {
      "parameters": {
        "jsCode": "const datos = $input.first().json;\n\nconst pokemon1 = datos.pokemonA;\nconst pokemon2 = datos.pokemonB;\n\n// Devuelve el valor base de una estadística, por ejemplo 'attack'\nfunction obtenerStat(pokemon, nombre) {\n  const stat = pokemon.stats.find(s => s.stat.name === nombre);\n  return stat ? stat.base_stat : undefined;\n}\n\nfunction calcularPoder(pokemon) {\n  const ataque = obtenerStat(pokemon, 'attack');\n  const defensa = obtenerStat(pokemon, 'defense');\n  const velocidad = obtenerStat(pokemon, 'speed');\n\n  return ataque * 2 + defensa + velocidad;\n}\n\nconst poder1 = calcularPoder(pokemon1);\nconst poder2 = calcularPoder(pokemon2);\n\nlet ganador = 'empate';\n\nif (poder1 > poder2) {\n  ganador = pokemon1.name;\n} else if (poder2 > poder1) {\n  ganador = pokemon2.name;\n}\n\nreturn [{\n  json: {\n    pokemon1: pokemon1.name,\n    pokemon2: pokemon2.name,\n    poder1,\n    poder2,\n    ganador,\n    estilo: $('Preparar datos').first().json.estilo\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
