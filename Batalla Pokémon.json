              "name": "prompt",
              "value": "={{ 'Narra una batalla Pokémon en español. ' + 'Pokémon 1: ' + $json.pokemon1 + ', con poder ' + $json.poder1 + '. ' + 'Pokémon 2: ' + $json.pokemon2 + ', con poder ' + $json.poder2 + '. ' + ($json.ganador === 'empate' ? 'Resultado: empate. ' : 'El ganador es: ' + $json.ganador + '. ') + 'Estilo de narración: ' + $json.estilo + '. ' + 'Usa entre 100 y 150 palabras. ' + ($json.ganador === 'empate' ? 'No inventes un ganador: la batalla debe terminar en empate.' : 'No cambies el ganador: la batalla debe terminar con la victoria de ' + $json.ganador + '.') }}",
